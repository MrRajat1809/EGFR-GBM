define                  = -DPOSRES  ; Position restrain the protein
integrator              = md        ; Leap-frog integrator
nsteps                  = 50000     ; 100 ps
dt                      = 0.002     ; 2 fs
nstenergy               = 500       ; Save energies every 1.0 ps
nstlog                  = 500       ; Update log file every 1.0 ps
nstxout-compressed      = 5000      ; Save compressed coordinates every 10.0 ps
continuation            = yes       ; Continuing from NVT
constraint_algorithm    = lincs     ; Constraint algorithm
constraints             = h-bonds   ; Constrain bonds involving hydrogen
lincs_iter              = 1         ; LINCS accuracy
lincs_order             = 4         ; LINCS order
cutoff-scheme           = Verlet    ; Buffered neighbor searching
ns_type                 = grid      ; Search neighboring grid cells
nstlist                 = 10        ; Update neighbor list every 10 steps
rcoulomb                = 1.0       ; Short-range electrostatic cutoff (nm)
rvdw                    = 1.0       ; Short-range van der Waals cutoff (nm)
coulombtype             = PME       ; Particle Mesh Ewald for long-range electrostatics
pme_order               = 4         ; Cubic interpolation
fourierspacing          = 0.16      ; Grid spacing for FFT
tcoupl                  = V-rescale ; Modified Berendsen thermostat
tc-grps                 = Protein_Ligand Water_and_Ions ; Custom temperature coupling!
tau_t                   = 0.1     0.1         ; Time constant (ps)
ref_t                   = 310     310         ; Target temperature (310 K)
pcoupl                  = Parrinello-Rahman   ; Pressure coupling on in NPT
pcoupltype              = isotropic           ; Uniform scaling of box vectors
tau_p                   = 2.0                 ; Time constant (ps)
ref_p                   = 1.0                 ; Reference pressure (bar)
compressibility         = 4.5e-5              ; Isothermal compressibility of water (bar^-1)
pbc                     = xyz       ; 3-D Periodic Boundary Conditions
DispCorr                = EnerPres  ; Account for cut-off vdW scheme
gen_vel                 = no        ; Velocity generation off (using NVT velocities)
